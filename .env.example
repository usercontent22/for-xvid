# Server-only secrets. Never expose database connection strings to browser code.
DATABASE_URL_1=
DATABASE_URL_2=

# Destination database used only by the manual DB1-to-DB3 migration workflow.
DATABASE_URL_3=

# Optional separate indexed read catalog; do not set this until it is provisioned and synced.
CATALOG_DATABASE_URL=

# Thumbnail image host; set to the exact base host for the paths stored in videos.img.
THUMBNAIL_BASE_URL=https://thumb-cdn77.xvideos-cdn.com

# Optional separate host for preview.mp4 files. Leave blank to use the thumbnail host.
PREVIEW_BASE_URL=

# Public base URL for the files inside Neon Object Storage bucket/path for-xvide/static.
# The app appends xxxworld-logo.svg and favicon/image names to this base.
STATIC_ASSETS_BASE_URL=

# Public canonical URL for absolute sitemap URLs, e.g. https://www.example.com
SITE_URL=

LOG_LEVEL=WARNING
